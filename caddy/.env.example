# ==============================================================================
# NextTurn Infrastructure - Caddy Ingress Environment Variables (Example Template)
# Sao chép tệp này thành .env và điều chỉnh thông số cho môi trường của bạn.
# (Copy this file to .env and adjust values for your environment)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Caddy Image Version
# ------------------------------------------------------------------------------
CADDY_IMAGE_TAG=2.9-alpine

# ------------------------------------------------------------------------------
# 2. Domain & Routing Configuration (Tên miền và định tuyến)
# For local development: localhost
# For production: yourdomain.com
# ------------------------------------------------------------------------------
NEXTTURN_DOMAIN=localhost

# ------------------------------------------------------------------------------
# 3. Host Port Mappings
# ------------------------------------------------------------------------------
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_ADMIN_PORT=2019

# ------------------------------------------------------------------------------
# 4. Frontend Static Build Directory Path (Đường dẫn thư mục build của FE)
# Default: ./html (built files inside infrastructure/caddy/html)
# Or point to your external frontend build: ../../frontend/dist
# ------------------------------------------------------------------------------
FRONTEND_STATIC_PATH=./html

# ------------------------------------------------------------------------------
# 5. Upstream Service Endpoints (Máy chủ dịch vụ nội bộ)
# Keycloak container: 'nextturn-keycloak:8080'
# Backend Spring Boot on host / Podman: 'host.containers.internal:8080'
# ------------------------------------------------------------------------------
KEYCLOAK_UPSTREAM=nextturn-keycloak:8080
BACKEND_UPSTREAM=host.containers.internal:8080
