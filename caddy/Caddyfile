# ==============================================================================
# NextTurn Ingress Gateway & Frontend Host - Caddyfile
# ==============================================================================

{
    admin 0.0.0.0:2019
    log {
        output stdout
        format console
        level INFO
    }
}

# ------------------------------------------------------------------------------
# Reusable Snippets
# ------------------------------------------------------------------------------
(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # Cho phép nhúng Widget từ bên thứ ba (bỏ X-Frame-Options SAMEORIGIN)
        # Cho phép mọi trang web nhúng widget NextTurn qua iframe
        Content-Security-Policy "frame-ancestors *;"
        
        -Server
    }
}

(compression) {
    encode zstd gzip
}

# ------------------------------------------------------------------------------
# NextTurn Primary Gateway
# ------------------------------------------------------------------------------
{$NEXTTURN_DOMAIN:localhost} {
    import security_headers
    import compression

    # --------------------------------------------------------------------------
    # 1. Keycloak Authentication & IAM Server
    # --------------------------------------------------------------------------
    @keycloak_paths {
        path /admin*
        path /realms*
        path /resources*
        path /js*
        path /auth*
    }
    handle @keycloak_paths {
        reverse_proxy {$KEYCLOAK_UPSTREAM:nextturn-keycloak:8080} {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Port {server_port}
        }
    }

    # --------------------------------------------------------------------------
    # 2. NextTurn Spring Boot Backend REST APIs & WebSocket
    # --------------------------------------------------------------------------
    @backend_paths {
        path /api/*
        path /ws/*
        path /actuator/*
        path /swagger-ui/*
        path /v3/api-docs/*
    }
    handle @backend_paths {
        reverse_proxy {$BACKEND_UPSTREAM:nextturn-backend:8080} {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # --------------------------------------------------------------------------
    # 3. NextTurn Frontend Web Client (NextJS)
    # --------------------------------------------------------------------------
    handle {
        reverse_proxy nextturn-frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}