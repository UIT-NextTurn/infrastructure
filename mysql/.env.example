# ==============================================================================
# NextTurn Infrastructure - MySQL Environment Variables (Example Template)
# Sao chép tệp này thành .env và điều chỉnh thông số cho môi trường của bạn.
# (Copy this file to .env and adjust values for your environment)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MySQL Server Version & Host Port
# ------------------------------------------------------------------------------
# MySQL 8.4 LTS provides native multi-arch support (Linux ARM64 & AMD64)
MYSQL_IMAGE_TAG=8.4
MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# 2. Administrative Credentials (Quản trị viên root)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_secure_password_change_me

# ------------------------------------------------------------------------------
# 3. NextTurn Main Application Database & User
# ------------------------------------------------------------------------------
MYSQL_DATABASE=nextturn_db
MYSQL_USER=nextturn
MYSQL_PASSWORD=nextturn_password_change_me

# ------------------------------------------------------------------------------
# 4. Keycloak IAM Database Credentials
# (Được cấp quyền tự động thông qua initdb/01-init-schemas.sql)
# ------------------------------------------------------------------------------
KEYCLOAK_DB_NAME=keycloak_iam
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_secret
