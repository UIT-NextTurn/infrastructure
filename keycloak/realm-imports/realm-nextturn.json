{
  "realm": "nextturn",
  "displayName": "NextTurn Multi-Tenant Platform",
  "enabled": true,
  "sslRequired": "external",
  "organizationsEnabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "roles": {
    "realm": [
      {
        "name": "ROLE_SUPERADMIN",
        "description": "Global Platform Owner - Platform-wide governance and tenant oversight"
      }
    ],
    "client": {
      "nextturn-backend": [
        {
          "name": "TENANT_ADMIN",
          "description": "Tenant Administrator - Business settings, services, shifts, and staff provisioning"
        },
        {
          "name": "COUNTER_STAFF",
          "description": "Counter Staff - Queue calling, triage intake, and ticket status progression"
        }
      ]
    }
  },
  "clientScopes": [
    {
      "name": "organization",
      "description": "Organization membership and tenant context claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "organization-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "organization"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "profile",
    "email"
  ],
  "clients": [
    {
      "clientId": "nextturn-backend",
      "name": "NextTurn Backend Resource Server",
      "description": "Confidential client handling Direct Access Grants, token verification, and Admin REST API orchestration",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "replace-with-secure-backend-secret",
      "defaultClientScopes": [
        "profile",
        "email",
        "organization"
      ]
    }
  ]
}