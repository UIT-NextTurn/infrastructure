# ==============================================================================
# NextTurn Infrastructure - Keycloak Environment Variables (Example Template)
# Sao chép tệp này thành .env và điều chỉnh thông số cho môi trường của bạn.
# (Copy this file to .env and adjust values for your environment)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Keycloak Version & Image Configuration
# ------------------------------------------------------------------------------
KEYCLOAK_IMAGE_TAG=26.8.1

# ------------------------------------------------------------------------------
# 2. Keycloak Admin Credentials (Quản trị viên khởi tạo)
# ------------------------------------------------------------------------------
# In Keycloak 26+, KC_BOOTSTRAP_ADMIN_* replaces KEYCLOAK_ADMIN_*
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_change_me_in_prod

# ------------------------------------------------------------------------------
# 3. Oracle MySQL HeatWave Database Configuration
# (Cơ sở dữ liệu Oracle MySQL HeatWave - dùng schema riêng cho Keycloak IAM)
# ------------------------------------------------------------------------------
# In-network MySQL container: 'nextturn-mysql' (default) or OCI MySQL HeatWave private IP / hostname
MYSQL_HOST=nextturn-mysql
MYSQL_PORT=3306

# Keycloak isolated schema (cơ sở dữ liệu / schema riêng cho IAM)
KEYCLOAK_DB_NAME=keycloak_iam
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_secret_password_change_me

# Set to true if connecting to OCI MySQL HeatWave over TLS/SSL
MYSQL_USE_SSL=false

# Optional: Complete JDBC connection URL override
# KC_DB_URL=jdbc:mysql://10.0.1.100:3306/keycloak_iam?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ------------------------------------------------------------------------------
# 4. Host Port Mappings (Cổng mạng)
# Note: NextTurn Spring Boot backend defaults to port 8080.
# Keycloak is mapped to port 8180 on the host to avoid port conflict (xung đột cổng).
# ------------------------------------------------------------------------------
KEYCLOAK_PORT=8180
KEYCLOAK_HTTPS_PORT=8443
KEYCLOAK_MANAGEMENT_PORT=9000

# ------------------------------------------------------------------------------
# 5. Keycloak Runtime Configuration
# ------------------------------------------------------------------------------
KEYCLOAK_LOG_LEVEL=INFO
